From da847e516090bb90cfacc7dca9cb59bc5a6553ed Mon Sep 17 00:00:00 2001
From: fnrir <fnr1r0@protonmail.com>
Date: Wed, 21 Oct 2026 22:26:15 +0200
Subject: [PATCH] feat(Maker): add fetch --assume-saved

---
 lib/compiler/Maker.zig | 68 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 66 insertions(+), 2 deletions(-)

diff --git a/lib/compiler/Maker.zig b/lib/compiler/Maker.zig
index 12df472dea..e29f863163 100644
--- a/lib/compiler/Maker.zig
+++ b/lib/compiler/Maker.zig
@@ -1656,6 +1656,59 @@ fn configure(graph: *Graph, options: ConfigureOptions) !ScannedConfig {
     };
 }
 
+const HashMismatchInfo = struct {
+    expected: []const u8,
+    actual: []const u8,
+};
+
+const AssumeSavedCheckError = union(enum) { DepNotSaved, HashMismatch: HashMismatchInfo };
+
+fn assume_saved_check(
+    name: []const u8,
+    package_hash_slice: []const u8,
+    manifest: Package.Manifest,
+) ?AssumeSavedCheckError {
+    const dep = manifest.dependencies.get(name) orelse return .DepNotSaved;
+    const hash = dep.hash orelse return null;
+    if (mem.eql(u8, hash, package_hash_slice)) return null;
+    return .{ .HashMismatch = .{ .expected = package_hash_slice, .actual = hash } };
+}
+
+fn ext_err_hash_mismatch(info: HashMismatchInfo, name: []const u8) void {
+    log.err("dependency {q} hash mismatch!", .{name});
+    log.err("  expected: {s}", .{info.expected});
+    log.err("  actual:   {s}", .{info.actual});
+}
+
+fn ext_assume_saved(
+    io: Io,
+    name: []const u8,
+    package_hash_slice: []const u8,
+    manifest: Package.Manifest,
+    pkg_root: Path,
+) u8 {
+    const chk_err = assume_saved_check(name, package_hash_slice, manifest) orelse {
+        log.info("fetched existing dependency named {q} from cache", .{name});
+        return 0;
+    };
+    switch (chk_err) {
+        .DepNotSaved => log.err("dependency {q} not saved in manifest", .{name}),
+        .HashMismatch => |info| ext_err_hash_mismatch(info, name),
+    }
+    const root_handle = pkg_root.root_dir.handle;
+    const pkg_id = package_hash_slice;
+    if (root_handle.openDir(io, pkg_root.sub_path, .{})) |pkgs_dir| {
+        defer pkgs_dir.close(io);
+        log.info("deleting {s}", .{pkg_id});
+        pkgs_dir.deleteTree(io, pkg_id) catch |err| {
+            log.err("failed to delete: {}", .{err});
+        };
+    } else |err| {
+        log.warn("couldn't open zig-pkgs: {}", .{err});
+    }
+    return 1;
+}
+
 fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
     const environ_map = &graph.environ_map;
     const io = graph.io;
@@ -1670,6 +1723,7 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
         no,
         yes: ?[]const u8,
         exact: ?[]const u8,
+        assume,
     } = .no;
 
     var arg_i: usize = 0;
@@ -1694,6 +1748,8 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
                 save = .{ .exact = null };
             } else if (mem.cutPrefix(u8, arg, "--save-exact=")) |rest| {
                 save = .{ .exact = rest };
+            } else if (mem.eql(u8, arg, "--assume-saved")) {
+                save = .assume;
             } else {
                 fatal("unrecognized parameter: {q}", .{arg});
             }
@@ -1725,7 +1781,7 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
 
     const local_storage_ptr = switch (save) {
         .no => null,
-        .yes, .exact => ls: {
+        .yes, .exact, .assume => ls: {
             build_root = try findBuildRoot(arena, io, .{ .cwd_path = cwd_path });
             build_root_initialized = true;
 
@@ -1820,6 +1876,11 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
                 fatal("unable to determine name; fetched package has no build.zig.zon file", .{});
             break :name fetch.manifest.name;
         },
+        .assume => name: {
+            if (!fetch.have_manifest)
+                fatal("unable to determine name; fetched package has no build.zig.zon file", .{});
+            break :name fetch.manifest.name;
+        },
     };
 
     // The name to use in case the manifest file needs to be created now.
@@ -1865,7 +1926,7 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
 
         switch (save) {
             .yes => saved_path_or_url = try arena.print("{f}", .{uri}),
-            .no, .exact => {}, // keep the original URL
+            .no, .exact, .assume => {}, // keep the original URL
         }
     }
 
@@ -1891,6 +1952,8 @@ fn cmdFetch(gpa: Allocator, graph: *Graph, args: []const []const u8) !void {
         dependencies_init,
     });
 
+    if (save == .assume) process.exit(ext_assume_saved(io, name, package_hash_slice, manifest, local_storage.pkg_root));
+
     if (manifest.dependencies.get(name)) |dep| {
         if (dep.hash) |h| {
             switch (dep.location) {
@@ -2060,6 +2123,7 @@ const usage_fetch =
     \\  --save=[name]                 Add the fetched package to build.zig.zon as name
     \\  --save-exact                  Add the fetched package to build.zig.zon, storing the URL verbatim
     \\  --save-exact=[name]           Add the fetched package to build.zig.zon as name, storing the URL verbatim
+    \\  --assume-saved                (UNOFFICIAL) Used to fetch from local cache
     \\
 ;
 
-- 
